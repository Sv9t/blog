---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/dates.ts';
import { url } from '../../lib/paths.ts';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Блог">
  <section class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white mb-8">Блог</h1>
    
    <div class="space-y-8">
      {allPosts.map((post) => {
        const formattedDate = formatDate(post.data.pubDate);
        
        return (
          <a href={url(`blog/${post.id}`)} class="group block p-6 bg-gray-50 dark:bg-dark-800 rounded-xl border border-gray-100 dark:border-dark-700 hover:border-primary dark:hover:border-primary transition-colors">
            <time class="text-sm text-gray-500 dark:text-gray-400" datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
            <h2 class="text-2xl font-bold mt-2 mb-3 text-gray-900 dark:text-white group-hover:text-primary transition-colors">{post.data.title}</h2>
            <p class="text-gray-600 dark:text-gray-300">{post.data.description}</p>
            {post.data.tags && (
              <div class="flex gap-2 mt-4">
                {post.data.tags.map((tag) => (
                  <span class="text-xs font-mono text-primary">#{tag}</span>
                ))}
              </div>
            )}
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>