---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/paths.ts';
---

<BaseLayout title="404 - Not Found">
  <section class="flex-grow flex items-center justify-center py-20">
    <div class="text-center max-w-xl mx-auto">
      <!-- Иконка терминала -->
      <div class="mb-6 inline-flex items-center justify-center p-4 bg-red-100 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-full text-red-500">
        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      </div>

      <!-- Заголовок в стиле K8s -->
      <h1 class="text-6xl font-extrabold text-gray-900 dark:text-white mb-4">404</h1>
      <h2 class="text-2xl font-bold font-mono text-red-500 mb-6">Error: Resource Not Found</h2>
      
      <div class="bg-gray-50 dark:bg-dark-800 border border-gray-200 dark:border-dark-700 rounded-lg p-6 text-left font-mono text-sm text-gray-600 dark:text-gray-400 mb-8">
        <p class="mb-2"><span class="text-red-500">FATAL</span> The requested path could not be resolved.</p>
        <p class="mb-2">Possible reasons:</p>
        <ul class="list-disc list-inside pl-4 space-y-1 text-gray-500 dark:text-gray-500">
          <li>The deployment was rolled back</li>
          <li>Ingress rule is misconfigured</li>
          <li>Pod is in <span class="text-yellow-500">CrashLoopBackOff</span></li>
          <li>This page never existed</li>
        </ul>
      </div>

      <a href={url('/')} class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-dark-900 font-bold rounded-lg hover:opacity-90 transition-opacity">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
        Return to Base (/)
      </a>
    </div>
  </section>
</BaseLayout>