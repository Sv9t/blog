---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectStats from '../components/ProjectStats.tsx';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/dates.ts';
import { url } from '../lib/paths.ts';

// Получаем 4 последние статьи из блога
const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const projects = [
  { name: 'Cloud Infra Modules', description: 'Набор Terraform модулей для AWS.', repo: 'hashicorp/terraform' },
  { name: 'GitOps Deployer', description: 'Helm charts и ArgoCD конфигурации.', repo: 'argoproj/argo-cd' },
  { name: 'Monitoring Stack', description: 'Prometheus + Grafana стек для Kubernetes.', repo: 'prometheus/prometheus' },
];

// Данные для CI/CD Pipeline
const experience = [
  {
    id: 'job-4',
    company: 'Cloud Corp.',
    role: 'Senior DevOps Engineer',
    period: '2022 - Настоящее время',
    status: 'running',
    stack: ['AWS', 'Kubernetes', 'Terraform', 'ArgoCD']
  },
  {
    id: 'job-3',
    company: 'FinTech Startup',
    role: 'DevOps Engineer',
    period: '2020 - 2022',
    status: 'success',
    stack: ['GCP', 'Docker', 'GitLab CI', 'Helm']
  },
  {
    id: 'job-2',
    company: 'Outsource IT',
    role: 'System Administrator',
    period: '2018 - 2020',
    status: 'success',
    stack: ['Linux', 'Bash', 'Ansible', 'Nginx']
  },
  {
    id: 'job-1',
    company: 'DataCenter Solutions',
    role: 'Junior SysAdmin / Intern',
    period: '2016 - 2018',
    status: 'success',
    stack: ['Windows Server', 'VMware', 'Hardware']
  }
];
---

<BaseLayout title="Главная">
  
  <!-- Герой-секция (О себе) -->
  <section class="mb-20 py-12 border-b border-gray-200 dark:border-dark-700">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      
      <!-- Левая колонка: Информация для HR -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="relative flex h-3 w-3">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
          </span>
          <span class="text-sm font-medium text-green-600 dark:text-green-400">Открыт к предложениям</span>
        </div>
        
        <h1 class="text-4xl lg:text-5xl font-extrabold mb-4 text-gray-900 dark:text-white leading-tight">
          Привет, я <span class="text-primary">Святослав</span>
        </h1>
        
        <h2 class="text-2xl font-bold mb-6 text-gray-700 dark:text-gray-300">
          DevOps Инженер
        </h2>
        
        <p class="text-lg text-gray-600 dark:text-gray-400 mb-8 max-w-xl leading-relaxed">
          Строю надежную инфраструктуру, автоматизирую рутину и помогаю командам поставлять код быстрее. 
          Превращаю хаос ручных деплоев в предсказуемый CI/CD пайплайн.
        </p>

        <!-- Стек технологий -->
        <div class="flex flex-wrap gap-2 mb-8">
          {['Kubernetes', 'Docker', 'Terraform', 'AWS', 'CI/CD', 'Linux', 'GitOps'].map((tech) => (
            <span class="px-3 py-1 text-sm font-mono bg-gray-100 dark:bg-dark-800 text-primary border border-gray-200 dark:border-dark-700 rounded-full">
              {tech}
            </span>
          ))}
        </div>

        <!-- Кнопки действий -->
        <div class="flex flex-wrap gap-4">
          <a href={url('resume.pdf')} class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-dark-900 font-bold rounded-lg hover:opacity-90 transition-opacity">
            <svg class="w-5 h-5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Скачать резюме
          </a>
          <a href="https://t.me/твой_ник" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 border border-primary text-primary font-bold rounded-lg hover:bg-primary hover:text-dark-900 transition-colors">
            <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            Контакты
          </a>
        </div>
      </div>

      <!-- Правая колонка: Фото профиля (портретное) -->
      <div class="hidden md:flex justify-center">
        <img
          src={url('profile.jpg')}
          alt="Святослав — DevOps инженер"
          width="400"
          height="500"
          loading="lazy"
          decoding="async"
          class="w-full max-w-xs aspect-[4/5] object-cover object-top rounded-2xl border border-dark-700 shadow-2xl shadow-primary/10 ring-4 ring-primary/20"
          style="image-rendering: pixelated;"
        />
      </div>

    </div>
  </section>

  <!-- Секция «Обо мне»: контакты слева + profile.yaml справа -->
  <section class="mb-16 py-12 border-b border-gray-200 dark:border-dark-700">
    <div class="flex items-center gap-3 mb-8">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Обо мне</h2>
      <span class="text-sm font-mono text-gray-500 dark:text-gray-400">$ connect sv9t</span>
    </div>

    <div class="grid md:grid-cols-2 gap-10 lg:gap-14 items-start">

      <!-- Левая колонка: контакты -->
      <div>
        <div class="mb-6">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Давай обсудим 🚀</h3>
          <p class="text-gray-600 dark:text-gray-400 leading-relaxed max-w-md">
            Открыт к интересным предложениям, консультациям и фриланс-задачам по инфраструктуре и CI/CD. Отвечаю быстро.
          </p>
        </div>

        <div class="space-y-3">
          <!-- GitHub -->
          <a href="https://github.com/sv9t" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 p-4 bg-gray-50 dark:bg-dark-800 border border-gray-100 dark:border-dark-700 rounded-xl hover:border-primary dark:hover:border-primary transition-colors">
            <span class="flex-shrink-0 w-11 h-11 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400">
              <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            </span>
            <span class="flex-grow">
              <span class="block font-bold text-gray-900 dark:text-white">GitHub</span>
              <span class="block text-sm font-mono text-gray-500 dark:text-gray-400">@sv9t</span>
            </span>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          <!-- Telegram -->
          <a href="https://t.me/sv9t" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 p-4 bg-gray-50 dark:bg-dark-800 border border-gray-100 dark:border-dark-700 rounded-xl hover:border-primary dark:hover:border-primary transition-colors">
            <span class="flex-shrink-0 w-11 h-11 rounded-lg bg-cyan-100 dark:bg-cyan-900/30 flex items-center justify-center text-cyan-600 dark:text-cyan-400">
              <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24"><path d="M23.91 3.79L20.3 20.84c-.25 1.21-.98 1.5-2 .94l-5.5-4.07-2.66 2.57c-.3.3-.55.56-1.1.56-.72 0-.6-.27-.84-.95L6.3 13.7l-5.45-1.7c-1.18-.35-1.19-1.16.26-1.75l21.26-8.2c.97-.43 1.9.24 1.53 1.73z"/></svg>
            </span>
            <span class="flex-grow">
              <span class="block font-bold text-gray-900 dark:text-white">Telegram</span>
              <span class="block text-sm font-mono text-gray-500 dark:text-gray-400">@sv9t</span>
            </span>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>

          <!-- Email -->
          <a href="mailto:hello@sv9t.ru" class="group flex items-center gap-4 p-4 bg-gray-50 dark:bg-dark-800 border border-gray-100 dark:border-dark-700 rounded-xl hover:border-primary dark:hover:border-primary transition-colors">
            <span class="flex-shrink-0 w-11 h-11 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center text-green-600 dark:text-green-400">
              <svg class="w-6 h-6" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </span>
            <span class="flex-grow">
              <span class="block font-bold text-gray-900 dark:text-white">Email</span>
              <span class="block text-sm font-mono text-gray-500 dark:text-gray-400">hello@sv9t.ru</span>
            </span>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-primary group-hover:translate-x-1 transition-all" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Правая колонка: терминал profile.yaml -->
      <div>
        <div class="bg-dark-900 rounded-xl border border-dark-700 shadow-2xl shadow-primary/5 overflow-hidden">
          <div class="flex items-center gap-2 px-4 py-3 bg-dark-800 border-b border-dark-700">
            <div class="w-3 h-3 rounded-full bg-red-500"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
            <div class="w-3 h-3 rounded-full bg-green-500"></div>
            <span class="ml-2 text-sm text-gray-500 font-mono">profile.yaml</span>
          </div>
          <div class="p-6 font-mono text-sm leading-relaxed overflow-x-auto">
            <pre class="text-gray-300"><span class="text-purple-400">apiVersion</span><span class="text-gray-500">:</span> devops/v1
<span class="text-purple-400">kind</span><span class="text-gray-500">:</span> <span class="text-green-400">Engineer</span>
<span class="text-purple-400">metadata</span><span class="text-gray-500">:</span>
  <span class="text-purple-400">name</span><span class="text-gray-500">:</span> <span class="text-yellow-300">Святослав</span>
  <span class="text-purple-400">role</span><span class="text-gray-500">:</span> <span class="text-yellow-300">DevOps Engineer</span>
  <span class="text-purple-400">location</span><span class="text-gray-500">:</span> <span class="text-yellow-300">Russia (Remote)</span>
<span class="text-purple-400">spec</span><span class="text-gray-500">:</span>
  <span class="text-purple-400">status</span><span class="text-gray-500">:</span> <span class="text-green-400">OpenToWork</span> <span class="animate-pulse">🟢</span>
  <span class="text-purple-400">experience</span><span class="text-gray-500">:</span> <span class="text-yellow-300">5+ years</span>
  <span class="text-purple-400">stack</span><span class="text-gray-500">:</span>
    <span class="text-gray-500">-</span> <span class="text-cyan-300">Kubernetes</span>
    <span class="text-gray-500">-</span> <span class="text-cyan-300">Docker</span>
    <span class="text-gray-500">-</span> <span class="text-cyan-300">Terraform</span>
    <span class="text-gray-500">-</span> <span class="text-cyan-300">AWS/GCP</span>
  <span class="text-purple-400">focus</span><span class="text-gray-500">:</span>
    <span class="text-gray-500">-</span> Infrastructure as Code
    <span class="text-gray-500">-</span> Automation
    <span class="text-gray-500">-</span> Cloud-Native</pre>
          </div>
        </div>
      </div>

    </div>
  </section>

    <!-- CI/CD Pipeline (Опыт работы) -->
  <section class="mb-16 py-12 border-b border-gray-200 dark:border-dark-700">
    <div class="flex items-center gap-3 mb-8">
      <svg class="w-8 h-8 text-primary" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Career Pipeline</h2>
      <span class="text-sm font-mono text-gray-500 dark:text-gray-400 ml-2">.github/workflows/career.yml</span>
    </div>

    <!-- Обертка с ограничением высоты и градиентом -->
    <div class="relative">
      <div id="pipeline-container" class="overflow-hidden transition-[max-height] duration-500 ease-in-out" style="max-height: 340px;">
        <div class="space-y-0">
          {experience.map((job, index) => (
            <div class="relative flex gap-6">
              <!-- Линия и индикатор слева -->
              <div class="flex flex-col items-center">
                {job.status === 'running' ? (
                  <div class="relative flex items-center justify-center">
                    <span class="animate-ping absolute inline-flex h-8 w-8 rounded-full bg-green-400 opacity-50"></span>
                    <span class="relative inline-flex items-center justify-center h-8 w-8 rounded-full bg-green-500 border-2 border-dark-900 z-10">
                      <svg class="w-4 h-4 text-white animate-spin" aria-hidden="true" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                    </span>
                  </div>
                ) : (
                  <div class="relative flex items-center justify-center h-8 w-8 rounded-full bg-green-500 border-2 border-dark-900 z-10">
                    <svg class="w-4 h-4 text-white" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                  </div>
                )}
                
                {index < experience.length - 1 && (
                  <div class="w-0.5 flex-grow bg-dark-700 my-1"></div>
                )}
              </div>

              <!-- Карточка работы справа -->
              <div class={`flex-grow mb-8 p-5 bg-gray-50 dark:bg-dark-800 border rounded-lg transition-colors ${job.status === 'running' ? 'border-green-500/50 shadow-lg shadow-green-500/10' : 'border-gray-100 dark:border-dark-700'}`}>
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                  <div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white">{job.role}</h3>
                    <p class="text-primary font-medium">@ {job.company}</p>
                  </div>
                  <div class="flex items-center gap-2 text-sm font-mono text-gray-500 dark:text-gray-400">
                    <span>{job.period}</span>
                    {job.status === 'running' ? (
                      <span class="px-2 py-0.5 text-xs font-bold text-green-800 bg-green-100 dark:text-green-300 dark:bg-green-900/30 rounded">IN PROGRESS</span>
                    ) : (
                      <span class="px-2 py-0.5 text-xs font-bold text-gray-500 bg-gray-100 dark:text-gray-400 dark:bg-dark-700 rounded">COMPLETED</span>
                    )}
                  </div>
                </div>
                
                <div class="flex flex-wrap gap-2 mt-4">
                  {job.stack.map((tech) => (
                    <span class="px-2 py-1 text-xs font-mono bg-gray-100 dark:bg-dark-700 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-dark-600 rounded">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Градиент затемнения -->
      <div id="pipeline-fade" class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-white dark:from-dark-900 to-transparent pointer-events-none flex flex-col justify-end items-center pb-4 transition-opacity duration-300">
        <!-- Кнопка развертывания внутри градиента -->
        <button id="toggle-pipeline" type="button" aria-expanded="false" aria-controls="pipeline-container" class="pointer-events-auto group inline-flex items-center gap-2 px-4 py-2 border border-primary text-primary font-mono text-sm rounded-lg bg-white dark:bg-dark-900 hover:bg-primary hover:text-dark-900 transition-colors shadow-lg">
          <svg class="pipeline-icon-expand w-4 h-4 transition-transform group-hover:translate-y-0.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
          <svg class="pipeline-icon-collapse hidden w-4 h-4 transition-transform group-hover:-translate-y-0.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
          <span class="pipeline-label">Run step: view_full_history</span>
        </button>
      </div>
    </div>
  </section>

  <!-- Последние статьи -->
  <section class="mb-16">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Последние статьи</h2>
      <a href={url('blog')} class="text-primary hover:underline">Все статьи &rarr;</a>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {latestPosts.map((post) => {
        const formattedDate = formatDate(post.data.pubDate);
        
        return (
          <a href={url(`blog/${post.id}`)} class="group block p-6 bg-gray-50 dark:bg-dark-800 rounded-xl border border-gray-100 dark:border-dark-700 hover:border-primary dark:hover:border-primary transition-colors">
            <time class="text-sm text-gray-500 dark:text-gray-400" datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
            <h3 class="text-xl font-semibold mt-2 mb-3 text-gray-900 dark:text-white group-hover:text-primary transition-colors">{post.data.title}</h3>
            <p class="text-gray-600 dark:text-gray-300">{post.data.description}</p>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Проекты -->
  <section>
    <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Пет-проекты и Open Source</h2>
    <div class="space-y-6">
      {projects.map((project) => (
        <div class="p-6 bg-gray-50 dark:bg-dark-800 rounded-xl border border-gray-100 dark:border-dark-700 flex flex-col md:flex-row justify-between md:items-center gap-4">
          <div>
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">{project.name}</h3>
            <p class="text-gray-600 dark:text-gray-300 mt-1">{project.description}</p>
          </div>
          <!-- Гидратация только когда блок попадает в зону видимости -->
          <ProjectStats client:visible repo={project.repo} />
        </div>
      ))}
    </div>
  </section>

  <script>
    const container = document.getElementById('pipeline-container');
    const fade = document.getElementById('pipeline-fade');
    const btn = document.getElementById('toggle-pipeline');
    const label = btn?.querySelector('.pipeline-label');
    const iconExpand = btn?.querySelector('.pipeline-icon-expand');
    const iconCollapse = btn?.querySelector('.pipeline-icon-collapse');

    if (btn && container && fade) {
      const COLLAPSED_HEIGHT = 340;

      const setExpanded = (expanded: boolean) => {
        if (expanded) {
          // Точная высота контента вместо магической 1000px
          container.style.maxHeight = `${container.scrollHeight}px`;
          fade.style.opacity = '0';
          btn!.setAttribute('aria-expanded', 'true');
          iconExpand?.classList.add('hidden');
          iconCollapse?.classList.remove('hidden');
          if (label) label.textContent = 'Collapse pipeline';
        } else {
          container.style.maxHeight = `${COLLAPSED_HEIGHT}px`;
          fade.style.opacity = '1';
          btn!.setAttribute('aria-expanded', 'false');
          iconExpand?.classList.remove('hidden');
          iconCollapse?.classList.add('hidden');
          if (label) label.textContent = 'Run step: view_full_history';
        }
      };

      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        setExpanded(!isExpanded);
      });
    }
  </script>
</BaseLayout>
