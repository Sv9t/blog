@echo off
chcp 65001 >nul
echo =========================================
echo   Создание статей для блога (Markdown)
echo =========================================
echo.

:: Удаляем старые файлы, если они там были, чтобы избежать конфликтов
del /q src\content\blog\*.md 2>nul

:: Создаем файл 1
echo [1/4] k8s-pipeline.md
echo  > tmp.b64
certutil -decode tmp.b64 src\content\blog\k8s-pipeline.md >nul 2>&1
del tmp.b64

:: Создаем файл 2
echo [2/4] terraform-vs-pulumi.md
echo  > tmp.b64
certutil -decode tmp.b64 src\content\blog\terraform-vs-pulumi.md >nul 2>&1
del tmp.b64

:: Создаем файл 3
echo [3/4] github-actions-cicd.md
echo  > tmp.b64
certutil -decode tmp.b64 src\content\blog\github-actions-cicd.md >nul 2>&1
del tmp.b64

:: Создаем файл 4
echo [4/4] dockerfile-best-practices.md
echo  > tmp.b64
certutil -decode tmp.b64 src\content\blog\dockerfile-best-practices.md >nul 2>&1
del tmp.b64

echo.
echo =========================================
echo   Статьи успешно созданы!
echo =========================================
pause